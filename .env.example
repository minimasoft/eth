# =========================================================================
# eth-pipeline: Environment variables
# =========================================================================
# Copy this file to .env and fill in your credentials.
#
#   cp .env.example .env
#
# =========================================================================

# -------------------------------------------------------------------------
# OpenRouter — LLM-based event extraction
# -------------------------------------------------------------------------
# API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-fake

# Model identifier (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=openai/gpt-4o-mini

# -------------------------------------------------------------------------
# SurrealDB — document and event storage
# -------------------------------------------------------------------------
SURREAL_URL=ws://localhost:8000/rpc
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_NS=eth
SURREAL_DB=pipeline

# -------------------------------------------------------------------------
# MinIO — blob storage for uploaded documents
# -------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=eth-documents
MINIO_SECURE=false

# -------------------------------------------------------------------------
# Cloudflared Tunnel — expose services via Cloudflare Tunnel
# -------------------------------------------------------------------------
# Set TUNNEL_TOKEN to enable the cloudflared tunnel service in docker compose.
# Get a token from Cloudflare Zero Trust → Networks → Tunnels.
TUNNEL_TOKEN=

# -------------------------------------------------------------------------
# PDF Extraction — text extraction behavior tuning
# -------------------------------------------------------------------------
USE_PYPDF=false

# -------------------------------------------------------------------------
# Smart Chunking — sentence-aware chunk size configuration
# -------------------------------------------------------------------------
# Target chunk size in characters (default: 262144 = 256KB).
# Reduce for LLMs with smaller context windows.
# CHUNK_SIZE_TARGET=262144
